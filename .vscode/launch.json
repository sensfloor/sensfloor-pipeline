{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DATA_COLLECTION – Collect sensfloor and video data",
            "type": "debugpy",
            "request": "launch",
            "module": "data_collection.scripts.collect_sensfloor_data_and_video",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--serial-port",
                "/dev/tty.usbserial-A571V1ZF"
            ]
        },
        {
            "name": "DATA_COLLECTION – Extract poses from video",
            "type": "debugpy",
            "request": "launch",
            "module": "data_collection.scripts.extract_mediapipe_poses",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "INFERENCE – Mock server",
            "type": "debugpy",
            "request": "launch",
            "module": "inference.scripts.run_server",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--model",
                "checkpoints/rotation_model.pth",
                "--mock-file",
                "data/2025-12-02_12-24-03/sensfloor_readout.csv"
            ]
        },
        {
            "name": "INFERENCE – Server",
            "type": "debugpy",
            "request": "launch",
            "module": "inference.scripts.run_server",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--model",
                "checkpoints/rotation_model.pth",
                "--serial-port",
                "/dev/tty.usbserial-A571V1ZF"
            ]
        },
        {
            "name": "INFERENCE – Test client",
            "type": "debugpy",
            "request": "launch",
            "module": "inference.scripts.run_test_client",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "TRAINING – Train and test model",
            "type": "debugpy",
            "request": "launch",
            "module": "training.scripts.train",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--train",
                "--test",
            ]
        },
        {
            "name": "VISUALIZATIONS – Collected data",
            "type": "debugpy",
            "request": "launch",
            "module": "visualization.scripts.visualize_collected_data",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "VISUALIZATIONS – RoI floor",
            "type": "debugpy",
            "request": "launch",
            "module": "visualization.scripts.visualize_roi_floor",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
        },
        {
            "name": "VISUALIZATIONS – Rotation",
            "type": "debugpy",
            "request": "launch",
            "module": "visualization.scripts.visualize_rotation",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
        },
        {
            "name": "VISUALIZATIONS – Bone lengths",
            "type": "debugpy",
            "request": "launch",
            "module": "visualization.scripts.visualize_bone_lengths",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--csv",
                "data/2025-12-02_12-24-03/video_poses.csv",
            ]
        }
    ],
    "compounds": [
        {
            "name": "INFERENCE – Mock server and test client",
            "configurations": [
                "INFERENCE – Mock server",
                "INFERENCE – Test client"
            ],
            "stopAll": true
        },
        {
            "name": "INFERENCE – Server and test client",
            "configurations": [
                "INFERENCE – Server",
                "INFERENCE – Test client"
            ],
            "stopAll": true
        }
    ]
}