{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Collect sensfloor and video data",
            "type": "debugpy",
            "request": "launch",
            "module": "data_collection.scripts.collect_sensfloor_data_and_video",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--serial-port", "/dev/tty.usbserial-A571V1ZF"
            ]
        },
        {
            "name": "Extract poses from video",
            "type": "debugpy",
            "request": "launch",
            "module": "data_collection.scripts.extract_mediapipe_poses",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Start live estimation",
            "type": "debugpy",
            "request": "launch",
            "module": "inference.live_estimation",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Main (Train & Test)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": [
                "--train",
                "--test",
            ]
        },
        {
            "name": "Visualize collected data",
            "type": "debugpy",
            "request": "launch",
            "module": "visualization.scripts.visualize_collected_data",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Visualize RoI floor",
            "type": "debugpy",
            "request": "launch",
            "module": "visualization.scripts.visualize_roi_floor",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
        },
                {
            "name": "Visualize Rotation",
            "type": "debugpy",
            "request": "launch",
            "module": "visualization.scripts.visualize_rotation",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
        },
        {
            "name": "Visualize bone lengths",
            "type": "debugpy",
            "request": "launch",
            "module": "visualization.scripts.visualize_bone_lengths",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "--csv", "data/2025-12-02_12-24-03/video_poses.csv",
            ]
        }
    ]
}