{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DATA_COLLECTION – Collect Sensfloor and Video Data",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.data_collection.collect_sensfloor_data_and_video",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--serial-port",
        "/dev/tty.usbserial-A571V1ZF"
      ]
    },
    {
      "name": "DATA_COLLECTION – Extract Poses from Video",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.data_collection.extract_mediapipe_poses",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--data",
        "data/train"
      ]
    },
    {
      "name": "INFERENCE – Live Server",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.inference.run_server",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--model",
        "outputs/models/sensfloor_model",
        "--serial-port",
        "/dev/tty.usbserial-A571V1ZF"
      ]
    },
    {
      "name": "INFERENCE – Mock Server",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.inference.run_server",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--model",
        "outputs/models/sensfloor_model",
        "--mock-file",
        "data/extra/2025-12-09_15-52-01-line-subject4/sensfloor_readout.csv"
      ]
    },
    {
      "name": "INFERENCE – Test Client",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.inference.run_test_client",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "TRAINING – Train Model",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.training.train",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "TRAINING – Print Metrics",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.training.print_metrics",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--model",
        "outputs/models/sensfloor_model"
      ]
    },
    {
      "name": "TRAINING – Create Hold-out Predictions",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.training.create_hold_out_predictions",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--model",
        "outputs/models/sensfloor_model"
      ]
    },
    {
      "name": "TRAINING – Create Test Metrics",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.training.create_test_metrics",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--model",
        "outputs/models/sensfloor_model"
      ]
    },
    {
      "name": "VISUALIZATIONS – Collected Video and Readout",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.visualization.visualize_collected_data",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--data",
        "data/train/2025-12-16_12-20-54-line-subject1",
        "--signal-threshold",
        "140"
      ]
    },
    {
      "name": "VISUALIZATIONS – Position Tracking",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.visualization.visualize_position_tracking",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--data",
        "data/train/2025-12-16_12-20-54-line-subject1"
      ]
    },
    {
      "name": "VISUALIZATIONS – ROI Floor",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.visualization.visualize_roi_floor",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--data",
        "data/train/2025-12-16_12-20-54-line-subject1",
        "--data-index",
        "120"
      ]
    },
    {
      "name": "VISUALIZATIONS – Rotation",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.visualization.visualize_rotation",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--data",
        "data/train/2025-12-16_12-20-54-line-subject1",
        "--data-index",
        "120"
      ]
    },
    {
      "name": "VISUALIZATIONS – Bone Length Deviations",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.visualization.visualize_bone_lengths",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--csv",
        "data/train/2025-12-16_12-20-54-line-subject1/video_poses.csv"
      ]
    },
    {
      "name": "VISUALIZATIONS – Kalman Filter",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.visualization.visualize_kalman_filter",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--csv",
        "data/tracking/2026-02-09_09-35-00-house-subject3/sensfloor_readout.csv",
        "--start",
        "10",
        "--end",
        "42"
      ]
    },
    {
      "name": "VISUALIZATIONS – Pose Difference",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.visualization.visualize_pose_comparison",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--model",
        "outputs/models/sensfloor_model",
        "--data",
        "data/train/2025-12-16_12-20-54-line-subject1",
        "--data-index",
        "-4"
      ]
    },
    {
      "name": "VISUALIZATIONS – Readouts",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.visualization.visualize_readouts",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
    },
    {
      "name": "VISUALIZATIONS – Joint Movements",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.visualization.visualize_joint_movement",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "VISUALIZATIONS – Boxplot Test Metrics",
      "type": "debugpy",
      "request": "launch",
      "module": "scripts.visualization.visualize_metrics",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "args": [
        "--model",
        "outputs/models/sensfloor_model"
      ]
    }
  ],
  "compounds": [
    {
      "name": "INFERENCE – Mock server and test client",
      "configurations": [
        "INFERENCE – Mock Server",
        "INFERENCE – Test Client"
      ],
      "stopAll": true
    },
    {
      "name": "INFERENCE – Server and test client",
      "configurations": [
        "INFERENCE – Live Server",
        "INFERENCE – Test Client"
      ],
      "stopAll": true
    }
  ],
  "python.envFile": "${workspaceFolder}/.env",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "-q"
  ]
}